# Copy to .env for local runs outside docker compose. Inside compose these are
# set in docker-compose.yml and this file is not read.

ENVIRONMENT=local
LOG_LEVEL=INFO

# --- database -----------------------------------------------------------
# DATABASE_URL must point at the least-privilege app role. RLS is bypassed by
# superusers and by any role with BYPASSRLS, so pointing this at the owner
# silently disables every tenant policy — the single most dangerous
# misconfiguration in this system.
DATABASE_URL=postgresql+asyncpg://stylist_app:stylist_app_local_only@localhost:55432/stylist

# Owner DSN. Used ONLY by Alembic; the app must never connect with it.
MIGRATION_DATABASE_URL=postgresql://stylist_owner:stylist_owner_local_only@localhost:55432/stylist

DB_POOL_SIZE=20

# Tests run against the COMPOSE Postgres, not a locally installed one: the
# compose image is pgvector/pgvector:pg16, matching production and CI. A stock
# local Postgres has no pgvector, so the Phase 3 `vector(768)` column cannot
# even be created there.
#   MIGRATION_DATABASE_URL=postgresql://stylist_owner:stylist_owner_local_only@localhost:55432/stylist_test
#   DATABASE_URL=postgresql+asyncpg://stylist_app:stylist_app_local_only@localhost:55432/stylist_test

# --- redis: two logical databases, never one ----------------------------
# The queue db must be `noeviction`. A cache LRU policy on the same db will
# silently evict queued jobs.
REDIS_QUEUE_URL=redis://localhost:63790/0
REDIS_CACHE_URL=redis://localhost:63791/0

# rembg nests its cache as $U2NET_HOME/models/u2net/u2net.onnx. Unset, the
# code falls back to the container path /models/u2net, which does not exist on
# the host — so host test runs SKIP every matting test with "u2net weights
# absent" rather than failing. Skips exit 0, so that reads as a pass.
U2NET_HOME=./models/u2net

# Browser origins allowed to call the API. Without a match the browser blocks
# every request and the UI shows only "TypeError: Failed to fetch". Explicit
# allowlist, comma-separated — never "*" on a token-bearing API.
CORS_ALLOW_ORIGINS=http://localhost:3100

# --- object storage -----------------------------------------------------
S3_BUCKET=stylist-local
S3_ENDPOINT_URL=http://localhost:9000
# Only needed when the API reaches storage at a different host than the
# client does (i.e. inside docker compose). Leave unset in production.
# S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# Signed URLs only, <= 15 min (View 1). No object is ever public.
PRESIGN_TTL_SECONDS=900

# --- auth ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Settings refuses to start with the default value when ENVIRONMENT != local.
JWT_SECRET=dev-only-do-not-use-in-any-real-environment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30


# ---- observability (all optional) -----------------------------------------
# Tracing exports only when this is set; unset means the no-op path and zero
# cost. Install the 'observability' extra to make it effective:
#   pip install -e ".[observability]"
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Langfuse traces every model call. Also uncomment the callback in
# infra/litellm/config.yaml — with the callback on and these unset, the gateway
# logs an exporter error on every single call.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

# Real credentials. Gitignored -- never commit this file.

# --- model provider keys -------------------------------------------------
# PLACEHOLDERS ONLY. This file is COMMITTED — put real keys in .env, which is
# gitignored. A key pasted here is a key published the moment anyone pushes.
#
# Google AI Studio key (the `gemini/` prefix in infra/litellm/config.yaml).
# Note the free tier permits Google to train on submitted content, so this is
# for dev and eval runs; real user photos need Vertex AI's terms and the DPA.
# GEMINI_API_KEY=AIza...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ---- Google Calendar (Phase 8) ----------------------------------------
# From an OAuth 2.0 Client ID of type "Web application" in Google Cloud
# Console. Leave unset and the calendar feature reports "not connected";
# nothing else changes.
#
# THE REDIRECT URI MUST MATCH THE ONE REGISTERED ON THE CLIENT EXACTLY.
# Google compares the string, so a trailing slash is a different URI and the
# failure is `redirect_uri_mismatch` with no hint about which part differs.
# Add http://localhost:8080/calendar/callback to the client's
# "Authorised redirect URIs" before connecting.
#
# Scope requested is calendar.events.readonly — the narrowest that returns
# event titles. Only titles are read; attendees, descriptions and locations
# are excluded at the API call and never transmitted.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/calendar/callback

# ---- Push notifications (Phase 8) -------------------------------------
# PATH to a Firebase service-account JSON, never the key itself: a multi-line
# PEM inside an env var is mangled differently by every shell, .env parser and
# CI secret store, and the usual "fix" (stripping newlines) produces an
# unparseable key and a stack trace three layers down.
#
# Get it from Firebase Console -> Project settings -> Service accounts ->
# Generate new private key. Put it in ./secrets/, which is gitignored, and
# which the worker mounts read-only at /app/secrets.
#
# THE FILE CARRIES AN RSA PRIVATE KEY THAT CAN ACT AS THE PROJECT. Treat it
# like a password: never commit it, never paste it into a chat or an issue,
# and rotate it immediately if you do (Google Cloud Console -> IAM ->
# Service Accounts -> Keys).
#
# Unset disables push; every other feature is unaffected.
FIREBASE_CREDENTIALS_FILE=/app/secrets/firebase-service-account.json

# ---- Virtual try-on (Phase 10) ----------------------------------------
# One of: leffa | idm-vton | ootdiffusion. Unset degrades every try-on to an
# outfit board, which is the documented behaviour, not a failure.
#
# There is deliberately NO fallback chain and no per-category selection. That
# is a ROUTING table, and the plan is explicit that it must come from your own
# 10-body x 16-garment grid rather than from published Western benchmarks.
#
#   leffa         default. The only one with BOTH an explicit garment type and
#                 DressCode weights, so the only one that can be pointed at
#                 lower-body and full-body garments honestly.
#   idm-vton      VITON-HD. UPPER BODY ONLY — it takes no category argument.
#   ootdiffusion  upper / lower / dresses, via its process_dc entry point.
#
# NOTE: a saree (slot `drape`) is never rendered by any of them. It is not
# upper-body, not lower-body and not a dress; it is skipped and reported
# rather than guessed at. See packages/stylist_clients/vton_client.py.
VTON_PROVIDER=

# A Hugging Face token: https://huggingface.co/settings/tokens (role: read).
# NOT OPTIONAL IN PRACTICE. All three Spaces run on ZeroGPU, which rejects
# anonymous programmatic calls in well under a second with an empty error
# body — so without this, try-on silently degrades to the board on every
# request and the reason is unobvious. A render that actually ran takes 30s+;
# a sub-second failure is this.
VTON_API_TOKEN=

# Overrides the public Space URL for a self-hosted model or a dedicated
# Inference Endpoint. The Gradio protocol is identical; only the host changes.
# Worth doing if body photos should not leave your own infrastructure.
VTON_BASE_URL=

# Wall-clock ceiling for ONE render pass, seconds. Generous on purpose: the
# wait is a queue on shared hardware, not our latency. An outfit costs up to
# two passes (lower then upper), so budget double this.
VTON_TIMEOUT_S=900
