# Copy to infra/gcp/config.env (gitignored) and fill in. For a second
# environment copy it to e.g. staging.env and select it with
# GCP_CONFIG=infra/gcp/staging.env. Read by bootstrap.sh and deploy.sh.
# Nothing secret goes here: secrets live in Secret Manager.

PROJECT_ID=your-gcp-project-id
REGION=asia-south1

# The Vercel production origin, plus any custom domain. Comma-separated, exact
# origins (scheme + host, no trailing slash). The API's CORS list and the
# upload bucket's CORS policy are both built from this.
WEB_ORIGINS=https://your-app.vercel.app
# Where the calendar OAuth flow sends the user back to. One origin.
WEB_BASE_URL=https://your-app.vercel.app

# The api's public hostname. Leave empty to use a free
# api.<vm-ip>.sslip.io name (HTTPS works either way). To use your own domain,
# point an A record at the VM's IP first, then set it here.
API_DOMAIN=

# The budget VM. e2-medium (2 vCPU, 4 GB) is what the ~$35/month figure
# assumes; ZONE defaults to <REGION>-a.
VM_MACHINE=e2-medium
ZONE=

# Which LiteLLM model the tag stage asks for. vlm-tagger-mock needs no key.
VLM_MODEL=vlm-tagger

# Try-on (Phase 10). Leave VTON_PROVIDER empty to keep try-on disabled.
VTON_PROVIDER=
VTON_BASE_URL=
TRYON_DAILY_QUOTA=10
TRYON_MAX_PASSES=2

GOOGLE_CLIENT_ID=
GOOGLE_HOLIDAY_CALENDAR_ID=en.indian#holiday@group.v.calendar.google.com
SHOP_SUBID_PARAM=subid

# GitHub repository (owner/name) allowed to deploy through the Deploy workflow
# using Workload Identity Federation — no service-account key ever exists.
# Leave empty to deploy only from a laptop.
GITHUB_REPO=
