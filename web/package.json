{
  "name": "stylist-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p ${PORT:-3100}",
    "build": "next build",
    "start": "next start -p ${PORT:-3100}",
    "lint": "eslint .",
    "kill": "lsof -ti:${PORT:-3100} | xargs kill -9 2>/dev/null || true",
    "restart": "npm run kill && rm -rf .next && npm run build && npm run start",
    "fresh": "npm run kill && rm -rf .next && npm run dev"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "next": "16.3.4",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "@types/react": "19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "typescript": "5.7.3"
  }
}
