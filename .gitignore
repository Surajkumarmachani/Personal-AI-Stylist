__pycache__/
*.pyc
.venv/
venv/
.env
.DS_Store
node_modules/
eval/golden/images/

# Model weights: 176MB of ONNX, fetched by scripts/download_models.py and
# mounted into the ml container. Weights are data, not code — a binary this
# size in version control makes every clone painful and every bisect slow.
models/*
!models/.gitkeep

# Next.js
web/.next/
web/next-env.d.ts
*.tsbuildinfo

# Service-account credentials. A Firebase/GCP service account JSON carries a
# PRIVATE KEY that can act as the project — committing one is the single most
# common way these leak, and git history makes it unrecoverable without a
# rewrite. Broad patterns on purpose: the default download name is
# `<project>-firebase-adminsdk-<hash>-<id>.json`, which matches nothing
# obvious, so the directory is ignored wholesale rather than by filename.
secrets/
*service-account*.json
*adminsdk*.json
*-firebase-*.json

# Build artefact, regenerated by every `pip install -e`. It was tracked, so it
# churned in the diff on every editable install — noise in every review.
*.egg-info/
